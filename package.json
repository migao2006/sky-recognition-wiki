{
  "name": "sky-recognition-wiki",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node scripts/build-player-hair-names.mjs && npm run build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist",
    "typecheck": "tsc --noEmit --incremental false",
    "sync:iap:check": "node scripts/sync-iap-catalog.mjs",
    "sync:iap:write": "node scripts/sync-iap-catalog.mjs --write",
    "sync:catalog:check": "node scripts/check-catalog-identities.mjs",
    "sync:names:check": "node scripts/sync-fandom-zh-names.mjs --out dist/tmp/fandom-zh-names.json",
    "sync:names:write": "node scripts/sync-fandom-zh-names.mjs --write --out dist/tmp/fandom-zh-names.json",
    "sync:trade-names:check": "node scripts/sync-transaction-names.mjs",
    "sync:trade-names:write": "node scripts/sync-transaction-names.mjs --write",
    "collect:market-listings": "node scripts/collect-public-market-listings.mjs",
    "recognize:wardrobe": "node scripts/recognize-wardrobe-image.mjs",
    "consolidate:market-listings": "node scripts/consolidate-market-listing-snapshots.mjs",
    "collect:wiki-market": "node scripts/collect-wiki-market-evidence.mjs",
    "verify:wiki-market": "node scripts/verify-wiki-market-evidence.mjs",
    "sync:wiki-player-names:check": "node scripts/sync-wiki-player-names.mjs",
    "sync:wiki-player-names:write": "node scripts/sync-wiki-player-names.mjs --write"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cheerio": "^1.1.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "opencc-js": "^1.4.2",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "type": "module"
}
