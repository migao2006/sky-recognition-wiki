{
  "name": "sky-recognition-wiki",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node scripts/build-player-hair-names.mjs && npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist",
    "typecheck": "tsc --noEmit --incremental false",
    "sync:iap:check": "node scripts/sync-iap-catalog.mjs",
    "sync:iap:write": "node scripts/sync-iap-catalog.mjs --write",
    "sync:names:check": "node scripts/sync-fandom-zh-names.mjs --out dist/tmp/fandom-zh-names.json",
    "sync:names:write": "node scripts/sync-fandom-zh-names.mjs --write --out dist/tmp/fandom-zh-names.json"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
